# Export into the shell environment before starting uvicorn.
EVA_ML_PROVIDER=issai
# baseline or consultation-v1.1
EVA_CONSULTATION_VARIANT=consultation-v1.1
# The backend uses this verifier only in shadow or experiment mode.
EVA_AUDIT_PROFILE=baseline-plus
EVA_AUDIT_COMPONENTS=trace,policy,score,sentinel
# Set to a verified model revision or SHA-256 if caching with an external worker.
# EVA_MODEL_REVISION=
# Optional: port of an already running llama.cpp on 127.0.0.1 with the same model alias.
# EVA_LLAMA_WORKER_PORT=59068
EVA_LLAMA_SERVER=D:/EVA-ML/runtime/b12186/llama-server.exe
EVA_ISSAI_GGUF=D:/EVA-ML/models/Qwen3.5-9B-Kazakh.Q5_K_M.gguf
