{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/schemas/conversation-create.schema.json",
  "title": "conversation-create",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel": {
      "enum": [
        "agent_chat",
        "voice_call"
      ]
    },
    "language": {
      "enum": [
        "RU",
        "KZ",
        "EN"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timestamp": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "speaker": {
            "enum": [
              "client",
              "operator",
              "bot",
              "system",
              "unknown"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "translation": {
            "type": "object", "additionalProperties": false, "required": ["language","text"],
            "properties": {"language":{"type":"string","minLength":1},"text":{"type":"string","minLength":1}}
          },
          "event": {"const":"identity_verified"},
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "RU",
              "KZ",
              "EN",
              "mixed",
              "unknown"
            ]
          },
          "quality": {
            "type": "string",
            "minLength": 1
          },
          "end_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "offset_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [

          "speaker",
          "text"
        ]
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_operator_id": {
          "type": "string",
          "minLength": 1
        },
        "complete_start": {
          "type": "boolean"
        },
        "complete_end": {
          "type": "boolean"
        },
        "gaps": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "operation_id",
    "channel",
    "language",
    "messages"
  ]
}
