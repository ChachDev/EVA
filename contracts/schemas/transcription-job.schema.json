{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/schemas/transcription-job.schema.json",
  "title": "transcription-job",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "language": {
      "enum": [
        "RU",
        "KZ",
        "EN"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "needs_review"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "conversation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "https://eva.local/schemas/transcription-result.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "asset_id",
    "language",
    "status",
    "created_at",
    "updated_at",
    "conversation_id",
    "error_code",
    "result"
  ]
}
