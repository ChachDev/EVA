# Reference only: the service reads process environment, not this file automatically.
DATABASE_URL=postgresql+psycopg://eva:eva-local-dev@127.0.0.1:55432/eva
SEED_DEMO=false
ML_URL=http://127.0.0.1:8001
EVA_AUDIT_MODE=baseline
EVA_AUDIT_REVIEW=true
ML_TIMEOUT_SECONDS=20
ML_MAX_CONCURRENCY=1
EVALUATION_QUEUE_CAPACITY=4
REQUEST_MAX_BYTES=1048576
ML_MAX_RESPONSE_BYTES=2097152
# Audio stays under backend/data; relative paths resolve from the working directory.
MEDIA_ROOT=data/audio
AUDIO_MAX_BYTES=26214400
# Leave empty until a real local POST /v1/transcribe provider is available.
ASR_URL=
ASR_TIMEOUT_SECONDS=300
# Local audit metadata only; this is not an authenticated user identity.
REVIEWER_ID=local-reviewer
# Change the revision when changing the model, prompt, profile or component configuration.
EVA_BATCH_REVISION=local-v1
EVA_BATCH_WORKER=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional test database; the name must end in _test.
EVA_TEST_DATABASE_URL=postgresql+psycopg://eva:eva-local-dev@127.0.0.1:55432/eva_backend_test
# Supply the signed organizer URL only in your process environment when explicitly importing.
# EVA_DATASET_URL=
