# demo читает только локальные синтетические fixtures. http подключает Backend Chach.
VITE_API_MODE=http
VITE_API_URL=http://localhost:8000
# Не добавляйте API-ключи: все переменные VITE_* публичны в браузере.

# Optional public HTTPS origin for product-page canonical, hreflang and sitemap.
# Leave empty for local development. Never set this to the backend URL.
VITE_PUBLIC_SITE_URL=
